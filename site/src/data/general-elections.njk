---
layout: base.njk
title: General Elections
isGeneralElections: true
permalink: "/data/{{ config.sources.parliamentary_elections.slug }}/index.html"
---
<div class="section" style="padding-bottom:56px;">
  <h1>General Elections</h1>
  <p class="section__intro">
    Results for the locality's Westminster constituency across its last few general
    elections, from Democracy Club — general elections since 2010 only, not the House of
    Commons Library's fuller 1918-2019 archive (see CLAUDE.md for why).
  </p>

  {% for locality in parliamentaryElectionsLocalities %}
  {% set data = locality.parliamentaryElections %}
  <section style="margin-top:32px;">
    <h2 style="font-size:22px;">{{ data.filter.parliamentary_constituencies | join(", ") }}</h2>
    <p style="color:var(--text-muted);margin-top:8px;">
      Held by {{ data.elected_party_short }} since {{ data.latest_election_date }}
      ({{ data.elected_party_vote_share_pct }}% of the vote).
      Source: <a href="{{ data.source_url }}">{{ data.source_url }}</a>,
      fetched {{ data.fetched_at }}.
      <a href="{{ locality.downloadPath | url }}">Download the raw JSON</a>.
    </p>

    {% if locality.voteShareSvg %}
    <div style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:14px;padding:24px;margin-top:20px;">
      <h3 style="font-size:15px;font-weight:600;margin-bottom:12px;">Vote share over time</h3>
      {{ locality.voteShareSvg | safe }}
    </div>
    {% else %}
    <p style="margin-top:16px;font-size:13px;color:var(--text-muted);">Chart not generated yet — run <code>pipeline/elections_charts.py</code>.</p>
    {% endif %}

    {% for election_date in data.election_dates | reverse %}
    <h3 style="font-size:15px;font-weight:600;margin-top:24px;margin-bottom:8px;">{{ election_date }}</h3>
    <div style="overflow-x:auto;margin-top:8px;">
      <table style="width:100%;font-size:13.5px;">
        <thead>
          <tr>
            <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text-muted);">Candidate</th>
            <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text-muted);">Party</th>
            <th style="text-align:right;padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text-muted);">Votes</th>
            <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text-muted);">Elected</th>
          </tr>
        </thead>
        <tbody>
          {% for candidate in data.results %}
          {% if candidate.election_date == election_date %}
          <tr>
            <td style="padding:9px 10px;border-bottom:1px solid var(--border);">{{ candidate.person_name }}</td>
            <td style="padding:9px 10px;border-bottom:1px solid var(--border);">{{ candidate.party_name }}</td>
            <td style="padding:9px 10px;border-bottom:1px solid var(--border);text-align:right;">{{ candidate.votes_cast }}</td>
            <td style="padding:9px 10px;border-bottom:1px solid var(--border);">{{ "Yes" if candidate.elected == "t" else "" }}</td>
          </tr>
          {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endfor %}
  </section>
  {% else %}
  <p style="margin-top:24px;">No processed data found yet — run <code>ingest/parliamentary_elections.py</code> first.</p>
  {% endfor %}
</div>
