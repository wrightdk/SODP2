---
layout: base.njk
title: Population & Economy
isPopulation: true
permalink: "/data/{{ config.sources.ons_population.slug }}/index.html"
---
<div class="section" style="padding-bottom:56px;">
  <h1>Population &amp; Economy</h1>
  <p class="section__intro">
    ONS small-area mid-year population estimates via Nomis, summed across the locality's
    LSOAs — filtered to the built-up area itself, not the wider local authority.
  </p>

  {% for locality in populationLocalities %}
  {% set data = locality.population %}
  <section style="margin-top:32px;">
    <h2 style="font-size:22px;">{{ locality.slug }} — mid-{{ data.year }}</h2>
    <p style="color:var(--text-muted);margin-top:8px;">
      {{ data.population }} residents across
      {{ data.by_lsoa.length }} LSOA{{ "s" if data.by_lsoa.length != 1 }}.
      Source: <a href="{{ data.source_url }}">{{ data.source_url }}</a>,
      fetched {{ data.fetched_at }}.
      <a href="{{ locality.downloadPath | url }}">Download the raw JSON</a>.
    </p>
    <div style="overflow-x:auto;margin-top:16px;">
      <table style="width:100%;font-size:13.5px;">
        <thead>
          <tr>
            <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text-muted);">LSOA</th>
            <th style="text-align:left;padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text-muted);">Code</th>
            <th style="text-align:right;padding:8px 10px;border-bottom:1px solid var(--border);color:var(--text-muted);">Population</th>
          </tr>
        </thead>
        <tbody>
          {% for lsoa in data.by_lsoa %}
          <tr>
            <td style="padding:9px 10px;border-bottom:1px solid var(--border);">{{ lsoa.name }}</td>
            <td style="padding:9px 10px;border-bottom:1px solid var(--border);">{{ lsoa.code }}</td>
            <td style="padding:9px 10px;border-bottom:1px solid var(--border);text-align:right;">{{ lsoa.population }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% else %}
  <p style="margin-top:24px;">No processed data found yet — run <code>ingest/ons_population.py</code> first.</p>
  {% endfor %}
</div>
