---
layout: base.njk
title: Home
isHome: true
---
<section class="hero" style="--hero-image: url('/{{ config.site.hero_image }}');">
  <div class="hero__inner">
    <p class="hero__eyebrow">{{ config.locality.name | upper }} &amp; {{ config.locality.region | upper }}</p>
    <h1>Public data, decoded for {{ config.locality.name }}.</h1>
    <p class="hero__lede">{{ config.narrative.tagline }}. Every figure on this site is traceable back to its source and the date it was fetched.</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/crime/">Explore the data</a>
    </div>
  </div>
  {% if config.site.hero_image_credit %}
  <p class="hero__credit">{{ config.site.hero_image_credit }}</p>
  {% endif %}
</section>

{% if lastUpdate %}
<div class="ticker">
  <div class="ticker__inner">
    <span class="ticker__dot" aria-hidden="true"></span>
    <span>Updated {{ lastUpdate.daysAgo }} day{{ "s" if lastUpdate.daysAgo != 1 }} ago:
      <strong style="color:var(--text);">{{ lastUpdate.title }} — {{ lastUpdate.updateLabel }}</strong></span>
    <span class="ticker__badge">OGL v3</span>
  </div>
</div>
{% endif %}

<section class="section">
  <h2>Explore {{ config.locality.name }}'s data</h2>
  <p class="section__intro">{{ homeCards.length }} national dataset{{ "s" if homeCards.length != 1 }}, filtered down to the {{ config.locality.name }} built-up area only.</p>

  <div class="card-grid">
    {% for card in homeCards %}
      {% if card.isSoon %}
      <div class="card card--soon">
        <div class="card__top">
          <h3 class="card__title">{{ card.title }}</h3>
          <span class="card__soon-badge">SOON</span>
        </div>
        <span class="card__figure">{{ card.figure }}</span>
        <p class="card__unit">{{ card.unit }}</p>
        <p class="card__desc">{{ card.desc }}</p>
      </div>
      {% else %}
      <a class="card" href="/crime/">
        <div class="card__top">
          <h3 class="card__title">{{ card.title }}</h3>
        </div>
        <span class="card__figure">{{ card.figure }}</span>
        <p class="card__unit">{{ card.unit }}</p>
        {% if card.hasSpark %}
        <svg viewBox="0 0 120 34" width="100%" height="34" style="margin-top:12px;" aria-hidden="true">
          <polyline points="{{ card.sparkPoints }}" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>
        </svg>
        {% endif %}
        <p class="card__desc">{{ card.desc }}</p>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="principles">
  <div class="principles__grid">
    <div>
      <h4>Traceable</h4>
      <p>Every figure carries the source URL and the exact date it was fetched — nothing here is unsourced.</p>
    </div>
    <div>
      <h4>Human-reviewed</h4>
      <p>Numbers are computed deterministically in code. An editor reads and approves every article before it publishes.</p>
    </div>
    <div>
      <h4>Openly licensed</h4>
      <p>Published under the Open Government Licence, same as the datasets it draws from.</p>
    </div>
  </div>
</section>
